{%- capture title -%}
    {{- 'products.product.store_availability.drawer.title' | t -}}
{%- endcapture -%}

{%- capture toggle_id -%}
    showDrawer-store-list
{%- endcapture -%}

<div class="product-drawers__item">
  <button
    type="button"
    class="product-drawers__item-toggle"
    data-target="{{ toggle_id }}"
    data-js-toggle="{{ toggle_id }}"
  >
    <span>{{- 'products.product.store_availability.store_availability.link' | t -}}</span>
    {% render 'icons', icon: 'slider-arrow-right' %}
  </button>
</div>

<store-list-drawer class="store-list-drawer">
  {%- capture skeleton -%}
    {% render 'skeleton' %}
    {% render 'skeleton' %}
    {% render 'skeleton' %}
    {% render 'skeleton' %}
  {%- endcapture -%}
  {%- render 'product-form-drawer', title: title, content: skeleton, toggle_id: toggle_id -%}
</store-list-drawer>
