{%- capture styles -%}
	--offset-top-desktop: {{ block.settings.offset_top_desktop }}px; {{-  -}}
	--offset-bottom-desktop: {{ block.settings.offset_bottom_desktop }}px; {{-  -}}
	--offset-top-mobile: {{ block.settings.offset_top_mobile }}px; {{-  -}}
	--offset-bottom-mobile: {{ block.settings.offset_bottom_mobile }}px;
{%- endcapture -%}

{%- if block.settings.banner_image != blank -%}
	<div class="product-image-banner" style="{{ styles }}">
		{%- if block.settings.banner_link != blank -%}
			<a href="{{ block.settings.banner_link }}" class="product-image-banner__link">
		{%- endif -%}
		
		<img class="product-image-banner__image"
			 src="{{ block.settings.banner_image | image_url: width: 800 }}"
			 srcset="{{ block.settings.banner_image | image_url: width: 400 }} 400w,
					{{ block.settings.banner_image | image_url: width: 800 }} 800w,
					{{ block.settings.banner_image | image_url: width: 1200 }} 1200w"
			 sizes="(max-width: 768px) 100vw, 50vw"
			 alt="{{ block.settings.banner_alt | default: block.settings.banner_image.alt | escape }}"
			 width="{{ block.settings.banner_image.width }}"
			 height="{{ block.settings.banner_image.height }}"
			 loading="lazy"
		>
		
		{%- if block.settings.banner_link != blank -%}
			</a>
		{%- endif -%}
	</div>
	<style>
		.product-image-banner{
			margin-bottom: 10px;
		}
	</style>
{%- endif -%}
