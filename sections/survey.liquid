<script>
  let currentStep = 1;
  const totalSteps = 3;

  const stepData = {
    1: {
      title: '{{ section.settings.step1_title }}',
      content: '{{ section.settings.step1_content }}',
    },
    2: {
      title: '{{ section.settings.step2_title }}',
      content: '{{ section.settings.step2_content }}',
    },
    3: {
      title: '{{ section.settings.step4_title }}',
      content: '{{ section.settings.step4_content }}',
    },
  };

  function setMaxDate() {
    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const day = String(today.getDate()).padStart(2, '0');
    const maxDate = `${year}-${month}-${day}`;

    const birthDateInput = document.querySelector('input[name="birth_date"]');
    if (birthDateInput) {
      birthDateInput.setAttribute('max', maxDate);
    }
  }

  function showStep(step) {
    currentStep = step;

    document.querySelectorAll('.form-step').forEach((el) => {
      el.classList.remove('active');
    });

    const currentStepEl = document.querySelector(`.form-step[data-step="${step}"]`);
    if (currentStepEl) {
      currentStepEl.classList.add('active');
    }

    document.querySelectorAll('.desktop-steps .step-item').forEach((el, index) => {
      el.classList.toggle('active', index + 1 === step);
    });

    document.querySelectorAll('.desktop-steps .step-info').forEach((el, index) => {
      el.classList.toggle('active', index + 1 === step);
    });

    const progressPercent = (step / totalSteps) * 100;
    const progressFill = document.getElementById('progress-fill');
    if (progressFill) {
      progressFill.style.width = progressPercent + '%';
    }

    const mobileTitle = document.getElementById('mobile-step-title');
    const mobileContent = document.getElementById('mobile-step-content');

    if (mobileTitle && mobileContent && stepData[step]) {
      mobileTitle.textContent = stepData[step].title;
      if (mobileContent.querySelector('h2')) {
        mobileContent.querySelector('h2').textContent = stepData[step].content;
      }
    }
  }

  function validateStep(step) {
    const stepEl = document.querySelector(`.form-step[data-step="${step}"]`);
    const requiredFields = stepEl.querySelectorAll('[required]');
    let isValid = true;

    stepEl.querySelectorAll('.form-field').forEach((field) => {
      field.classList.remove('error');
    });

    if (step === 3) {
      const subscriptionSelected = stepEl.querySelector('input[name="subscription"]:checked');
      const subscriptionError = stepEl.querySelector('.subscription-error');
      const agreeCheckbox = stepEl.querySelector('#agreeCheckbox');
      const agreeError = stepEl.querySelector('.agree-error');

      if (!subscriptionSelected) {
        isValid = false;
        if (subscriptionError) {
          subscriptionError.style.display = 'block';
        }
      } else if (subscriptionError) {
        subscriptionError.style.display = 'none';
      }

      if (!agreeCheckbox || !agreeCheckbox.checked) {
        isValid = false;
        if (agreeError) {
          agreeError.style.display = 'block';
        }
      } else if (agreeError) {
        agreeError.style.display = 'none';
      }

    }

    requiredFields.forEach((field) => {
      const fieldContainer = field.closest('.form-field');

      if (!field.value.trim() || (field.tagName === 'SELECT' && field.value === '')) {
        isValid = false;
        fieldContainer.classList.add('error');
        field.style.borderColor = '#dc2626';
      } else {
        fieldContainer.classList.remove('error');
        field.style.borderColor = '#000';
      }

      if (field.type === 'email' && field.value.trim()) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(field.value)) {
          isValid = false;
          fieldContainer.classList.add('error');
          field.style.borderColor = '#dc2626';
        }
      }

      if (field.type === 'date' && field.value) {
        const selectedDate = new Date(field.value);
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        if (selectedDate > today) {
          isValid = false;
          fieldContainer.classList.add('error');
          field.style.borderColor = '#dc2626';
          const errorMessage = fieldContainer.querySelector('.error-message');
          if (errorMessage) {
            {% if request.locale.iso_code == 'ar' %}
               errorMessage.textContent = "يرجى اختيار تاريخ ميلادك والتأكد من أنه ليس تاريخًا مستقبليًا";
            {% else %}
            errorMessage.textContent = "Please select your birth date and ensure it's not a future date";
            {% endif %}
          }
        }
      }
    });

    return isValid;
  }

  function nextStep() {
    if (validateStep(currentStep)) {
      currentStep++;
      showStep(currentStep);
    }
  }

  function prevStep() {
    if (currentStep > 1) {
      currentStep--;
      showStep(currentStep);
    }
  }

  function validateAllSteps() {
    for (let step = 1; step <= totalSteps; step++) {
      if (!validateStep(step)) {
        showStep(step);
        return false;
      }
    }
    return true;
  }

  function addToCart() {
    if (!validateAllSteps()) {
      return;
    }

    const formData = new FormData(document.getElementById('surveyForm'));
    const data = Object.fromEntries(formData);

    const selectedVariantId = data.subscription;

    if (!selectedVariantId) {
      const step3El = document.querySelector('.form-step[data-step="3"]');
      const subscriptionError = step3El.querySelector('.subscription-error');
      if (subscriptionError) {
        subscriptionError.style.display = 'block';
      }
      return;
    }

    const cartForm = new FormData();
    cartForm.append('id', selectedVariantId);
    cartForm.append('quantity', '1');
    cartForm.append('properties[__cart_type]',  "web");
    cartForm.append('attributes[Survey Country Code]', data.country_code || '');
    cartForm.append('attributes[Survey Phone Number]', data.phone_number || '');
    cartForm.append('attributes[Survey Email]', data.email_address || '');
    cartForm.append('attributes[Survey First Name]', data.first_name || '');
    cartForm.append('attributes[Survey Last Name]', data.last_name || '');
    cartForm.append('attributes[Survey Birth Date]', data.birth_date || '');
    cartForm.append('attributes[Survey Gender]', data.gender || '');
    cartForm.append('attributes[Survey Nationality]', data.nationality || '');
    cartForm.append('attributes[Survey Preferred Language]', data.preferred_language || '');

    fetch('/cart/add.js', {
      method: 'POST', 
      body: cartForm,
    })
      .then((response) => response.json())
      .then((cartData) => {
        const checkoutParams = new URLSearchParams();

        // Add email to both checkout and shipping_address
        if (data.email_address) {
          checkoutParams.append('checkout[email]', data.email_address);
          checkoutParams.append('checkout[shipping_address][email]', data.email_address);
          checkoutParams.append('checkout[billing_address][email]', data.email_address);
        }

        // Add shipping address details
        if (data.first_name) {
          checkoutParams.append('checkout[shipping_address][first_name]', data.first_name);
          checkoutParams.append('checkout[billing_address][first_name]', data.first_name);
        }

        if (data.last_name) {
          checkoutParams.append('checkout[shipping_address][last_name]', data.last_name); 
          checkoutParams.append('checkout[billing_address][last_name]', data.last_name);
        }

        // Format phone with country code
  let formattedPhone = '';
  if (data.phone_number && data.country_code) {
    const countryCodeMap = {
      'KW': '+965',
      'SA': '+966',
      'AE': '+971'
    };
    const countryCode = countryCodeMap[data.country_code] || '';
    formattedPhone = `${countryCode}${data.phone_number}`.trim();
  }


        // Add formatted phone to both shipping and billing
        if (formattedPhone) {
          checkoutParams.append('checkout[phone]', formattedPhone);
          checkoutParams.append('checkout[shipping_address][phone]', formattedPhone);
          checkoutParams.append('checkout[billing_address][phone]', formattedPhone);
          checkoutParams.append('checkout[contact_phone]', formattedPhone);
        }

        if (data.email_address) {
          checkoutParams.append('checkout[billing_address][email]', data.email_address);
        }

        window.location.href = '/checkout?' + checkoutParams.toString();
      })
      .catch((error) => {
        console.error('Error:', error);
        alert('Error adding to cart. Please try again.');
      });
  }

  document.addEventListener('DOMContentLoaded', function () {
    setMaxDate();
    showStep(1);

    document.querySelectorAll('input, select, textarea').forEach((field) => {
      field.addEventListener('input', function () {
        const fieldContainer = this.closest('.form-field');
        fieldContainer.classList.remove('error');
        this.style.borderColor = '#000';

        if (this.type === 'date') {
          const datePlaceholder = this.nextElementSibling;
          if (this.value && datePlaceholder && datePlaceholder.classList.contains('date-placeholder')) {
            datePlaceholder.style.display = 'none';
          }
        }
      });

      field.addEventListener('change', function () {
        const fieldContainer = this.closest('.form-field');
        fieldContainer.classList.remove('error');
        this.style.borderColor = '#000';

        if (this.type === 'date') {
          const datePlaceholder = this.nextElementSibling;
          if (this.value && datePlaceholder && datePlaceholder.classList.contains('date-placeholder')) {
            datePlaceholder.style.display = 'none';
          }
        }
      });

      if (field.type === 'date') {
        const datePlaceholder = field.nextElementSibling;
        if (datePlaceholder && datePlaceholder.classList.contains('date-placeholder')) {
          field.addEventListener('focus', function () {
            datePlaceholder.style.display = 'none';
          });

          field.addEventListener('blur', function () {
            if (!this.value) {
              datePlaceholder.style.display = 'block';
            }
          }
          );

          if (field.value) {
            datePlaceholder.style.display = 'none';
          }
        }
      }
    });

    const agreeCheckbox = document.getElementById('agreeCheckbox');
    if (agreeCheckbox) {
      agreeCheckbox.addEventListener('change', function () {
        const agreeError = document.querySelector('.agree-error');
        if (agreeError) {
          agreeError.style.display = 'none';
        }
      });
    }
    if (agreeCheckbox) {
      const addToCartBtn = document.getElementById('addToCartBtn');
      addToCartBtn.disabled = true;
      agreeCheckbox.addEventListener('change', function() {
        addToCartBtn.disabled = !this.checked;
      });
    }



    // Add subscription selection handling
    document.querySelectorAll('input[name="subscription"]').forEach((radio) => {
      radio.addEventListener('change', function () {
        // Remove selection from all options
        document.querySelectorAll('.subscription-option').forEach(option => {
          option.classList.remove('selected');
        });
        
        // Add selection to current option
        this.closest('.subscription-option').classList.add('selected');
        
        // Hide error message
        const subscriptionError = document.querySelector('.subscription-error');
        if (subscriptionError) {
          subscriptionError.style.display = 'none';
        }
      });
    });
  });
</script>

