<style>
  /* =====================
     Base / Global Styles
     ===================== */
  .survey-form-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 20px;
    font-family: Arial, sans-serif;
  }

  .form-logo-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .form-section,
  .logo-section-wrapper,
  .logo-section {
    width: 100%;
  }

  /* Steps Navigation (desktop hidden by default) */
  .desktop-steps {
    display: none;
    margin-bottom: 30px;
  }
  .desktop-steps .steps-nav {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
  }
  .desktop-steps .step-item {
    text-align: center;
    padding: 10px;
    color: #666;
    font-weight: 500;
    white-space: nowrap;
  }
  .desktop-steps .step-item.active {
    color: #dc2626;
  }
  .desktop-steps hr {
    border: none;
    height: 1px;
    background-color: #e5e5e5;
    margin: 0 0 20px 0;
  }
  .desktop-steps .step-info {
    display: none;
    text-align: center;
  }

  /* Mobile Progress Bar */
  .mobile-progress {
    display: block;
    margin-bottom: 20px;
  }
  .progress-bar {
    width: 100%;
    height: 4px;
    background-color: #e5e5e5;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 15px;
  }
  .progress-fill {
    height: 100%;
    background-color: #dc2626;
    transition: width 0.3s ease;
    display: block !important;
  }

  /* Mobile Step Info */
  .mobile-step-info {
    display: block;
    margin-bottom: 20px;
  }
  .mobile-step-title {
    font-size: 22px;
    font-weight: bold;
    color: #dc2626;
    margin-bottom: 8px;
  }
  .mobile-step-content {
    color: #333;
    line-height: 1.5;
    font-size: 14px;
  }

  /* Logo Section */
  .logo-section {
    margin-bottom: 30px;
    padding: 40px 20px;
    border-radius: 8px;
    background-color: #f8f8f8;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    order: 1;
  }
  .logo-section.has-bg-image {
    background-color: transparent;
  }
  .logo-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
    gap: 30px;
  }
  .logo-item {
    max-height: 80px;
  }
  .logo-item img,
  .logo-item svg {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Form Steps */
  .form-step {
    display: none;
  }
  .form-step.active {
    display: block;
  }
  .step-title {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 10px;
    color: #333;
  }
  .step-content {
    color: #dc2626;
    margin-bottom: 30px;
    line-height: 1.5;
  }

  /* Contact Info Section */
  .contact-info-section {
    background-color: #f8f8f8;
    padding: 40px;
    border-radius: 8px;
    margin-bottom: 30px;
  }
  .contact-info-title {
    font-size: 26px;
    font-weight: bold;
    color: #333;
    margin-bottom: 10px;
    text-align: left;
  }
  .contact-info-subtitle {
    color: #666;
    font-size: 14px;
    margin-bottom: 30px;
    text-align: left;
  }

  /* Form Fields */
  .form-group {
    margin-bottom: 20px;
  }
  .form-row {
    display: flex;
    gap: 15px;
    flex-direction: column;
  }
  .form-field {
    flex: 1;
    width: 100%;
    position: relative;
  }
  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #000;
    font-size: 14px;
    box-sizing: border-box;
    border-radius: 4px;
  }
  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: #000;
    opacity: 1;
  }
  .form-field select option[value=""] {
    color: #999;
    font-style: italic;
  }
  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: #dc2626;
  }
  .form-field textarea {
    resize: vertical;
    min-height: 100px;
  }
  .form-field select {
    background: #fff;
    background-image: url('data:image/svg+xml;utf8,<svg fill="black" viewBox="0 0 24 24" width="20" height="20" xmlns="http://www.w3.org/2000/svg"><path d="M7 10l5 5 5-5"/></svg>');
    background-repeat: no-repeat;
    background-position: right 10px center;
    background-size: 24px 24px;
    padding-right: 54px;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
  }

  /* Date input styles */
  .form-field input[type="date"] {
    position: relative;
    color: transparent;
  }
  .form-field input[type="date"]:focus,
  .form-field input[type="date"]:valid {
    color: #000;
  }
  .form-field input[type="date"]::-webkit-calendar-picker-indicator {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="%23000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-calendar"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>') no-repeat center center / contain;
    cursor: pointer;
    opacity: 1;
    -webkit-appearance: none;
  }
  .date-placeholder {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #000;
    pointer-events: none;
    font-size: 14px;
    transition: all 0.2s ease-in-out;
  }
  .form-field input[type="date"]:focus + .date-placeholder,
  .form-field input[type="date"]:valid + .date-placeholder {
    display: none;
  }
  .form-field.error .date-placeholder {
    top: 25%;
  }

  /* Subscription Table */
  .subscription-text {
    margin: 20px 0;
  }
  .subscription-options {
    border: 2px solid #000;
    width: 100%;
    background-color: #000;
    margin-bottom: 20px;
  }
  .subscription-header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    background-color: #000;
    color: #fff;
    font-weight: bold;
    text-align: center;
  }
  .subscription-header div {
    padding: 15px 10px;
    border-right: 2px solid #fff;
  }
  .subscription-header div:last-child {
    border-right: none;
  }
  .subscription-option:nth-child(odd) {
    background-color: #E5E5E5;
  }
  .subscription-option:nth-child(even) {
    background-color: #fff;
  }
  .subscription-option {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-bottom: 2px solid #000;
    position: relative;
    cursor: pointer;
  }
  .subscription-option:last-child {
    border-bottom: none;
  }
  .subscription-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    margin: 0;
    z-index: 10;
  }
  .subscription-option .option-cell {
    padding: 15px 10px;
    text-align: center;
    border-right: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 500;
    position: relative;
  }
  .subscription-option .option-cell:last-child {
    border-right: none;
  }
  .subscription-option input[type="radio"]:checked ~ .option-cell {
    background-color: #000;
    color: #fff;
  }
  .subscription-option .subscription-value,
  .subscription-option .discount-value {
    font-size: 16px;
    font-weight: bold;
    color: #000;
  }
  .subscription-option .validation-value {
    font-size: 14px;
    color: #000;
  }
  .subscription-option input[type="radio"]:checked ~ .option-cell .subscription-value,
  .subscription-option input[type="radio"]:checked ~ .option-cell .discount-value,
  .subscription-option input[type="radio"]:checked ~ .option-cell .validation-value {
    color: #fff;
  }

  /* Buttons */
  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 30px;
  }
  .btn {
    padding: 15px 25px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }
  .btn-primary,
  .btn-secondary {
    background-color: #000;
    color: #fff;
  }
  .btn-primary:hover,
  .btn-secondary:hover {
    background-color: #333;
  }
  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Errors */
  .error-message {
    color: #dc2626;
    font-size: 12px;
    margin-top: 5px;
    display: none;
  }
  .form-field.error input,
  .form-field.error select,
  .form-field.error textarea {
    border-color: #dc2626;
  }
  .form-field.error .error-message {
    display: block;
  }
  .subscription-error {
    color: #dc2626;
    font-size: 12px;
    margin-bottom: 15px;
    display: none;
    text-align: center;
  }
  .agree-checkbox {
      {% comment %} display: flex; {% endcomment %}
      margin: 20px 0;
  }

  /* =====================
     Media Queries
     ===================== */

  /* Small Mobile (<=480px) */
  @media (max-width: 480px) {
    .logo-item { max-height: 60px; }
    .subscription-header { font-size: 13px; }
    .subscription-header div { padding: 12px 8px; }
    .subscription-option .option-cell { padding: 12px 8px; font-size: 14px; }
    .subscription-option .subscription-value,
    .subscription-option .discount-value { font-size: 16px; }
    .subscription-option .validation-value { font-size: 14px; }
    .contact-info-section { padding: 20px; }
    .contact-info-title { font-size: 24px; }
  }

  /* Mobile (<=767px) */
  @media (max-width: 767px) {
    .survey-form-container { display: flex; flex-direction: column; }
    .logo-section { width: 100%; }
    .mobile-progress { order: 3; }
    form { order: 4; }
    .desktop-steps { order: 0; }
  }

  /* Tablet & Up (>=768px) */
  @media (min-width: 768px) {
    .desktop-steps { display: block; }
    .mobile-progress,
    .mobile-step-info { display: none; }
    .form-row { flex-direction: row; }
    .form-row.contact-row { flex-direction: row; }
    .form-row.contact-row .form-field { flex: 1; }
    .form-field.half-width { flex: 0 0 calc(50% - 7.5px); }
    .form-field.full-width { flex: 0 0 100%; }
    .btn { padding: 15px 25px; margin-left: 10px; font-size: 14px; }
    .form-actions { justify-content: flex-end; }
    .desktop-steps .step-info { display: none !important; }
    .logo-item { max-height: 100px; }
  }

  /* Desktop (>=992px) */
  @media (min-width: 992px) {
    .form-logo-wrapper { grid-template-columns: 1fr 1fr; }
    .form-section { flex: 2; }
    .logo-section-wrapper { flex: 1; }
    .logo-section {
      height: 100%;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<div class="survey-form-container">
  <div class="form-logo-wrapper">
    {% assign logo_bg_color = section.settings.logo_background_color | default: '#f8f8f8' %}
    {% assign logo_bg_image = section.settings.logo_background_image %}

    <div class="form-section">
      <form id="surveyForm" method="post" action="/cart/add">
        <!-- UPDATED STEP 1 WITH NEW DESIGN -->

        <div class="desktop-steps">
          <div class="steps-nav">
            <div class="step-item active" data-step="1">{{ section.settings.step1_title }}</div>
            <div class="step-item" data-step="2">{{ section.settings.step2_title }}</div>
            <div class="step-item" data-step="3">{{ section.settings.step4_title }}</div>
          </div>
          <hr>

          <div class="step-info active" data-step="1">
            <h3>{{ section.settings.step1_title }}</h3>
            <p>{{ section.settings.step1_content }}</p>
          </div>
          <div class="step-info" data-step="2">
            <h3>{{ section.settings.step2_title }}</h3>
            <p>{{ section.settings.step2_content }}</p>
          </div>
          <div class="step-info" data-step="3">
            <h3>{{ section.settings.step4_title }}</h3>
            <p>{{ section.settings.step4_content }}</p>
          </div>
        </div>

        <div class="mobile-progress">
          <div class="progress-bar">
            <div class="progress-fill" id="progress-fill" style="width: 33.33%"></div>
          </div>

          <div class="mobile-step-info">
            <div class="mobile-step-title" id="mobile-step-title">{{ section.settings.step1_title }}</div>
            <div class="mobile-step-content" id="mobile-step-content">
              <h2>{{ section.settings.step1_content }}</h2>
            </div>
          </div>
        </div>

        <div class="form-step active" data-step="1">
          <div class="contact-info-section">
            <h2 class="contact-info-title">{{ section.settings.contact_title | default: '1. Contact Information' }}</h2>
            <p class="contact-info-subtitle">
              {{ section.settings.contact_subtitle | default: 'Please enter your contact details below' }}
            </p>

            <div class="form-group">
              <div class="form-row contact-row">
                <div class="form-field">
                  <select name="country_code" required>
                    <option value="" disabled selected>{{ 'surveyform.countrycode' | t }} *</option>
                    <option value="KW">Kuwait (+965)</option>
                    <option value="SA">Saudi Arabia (+966)</option>
                    <option value="AE">UAE (+971)</option>
                  </select>
                  <div class="error-message">{{ 'surveyform.errorcountrycode' | t }}</div>
                </div>
                <div class="form-field">
                  <input
                    type="tel"
                    name="phone_number"
                    placeholder="{{ 'surveyform.phone' | t }} *"
                    required
                    max="8"
                    maxlength="8"
                  >
                  <div class="error-message">{{ 'surveyform.phoneerror' | t }}</div>
                </div>
              </div>
            </div>

            <div class="form-group">
              <div class="form-field">
                <input type="email" name="email_address" placeholder="{{ 'newsletter.label' | t }} *" required>
                <div class="error-message">{{ 'surveyform.emailerror' | t }}</div>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <div></div>
            <button type="button" class="btn btn-primary" onclick="nextStep()">
              {{ 'surveyform.next' | t -}}
              <span>→</span>
            </button>
          </div>
        </div>

        <div class="form-step" data-step="2">
          <div class="form-group">
            <div class="form-row">
              <div class="form-field half-width">
                <input type="text" name="first_name" placeholder="{{ 'customer.addresses.first_name' | t }} *" required>
                <div class="error-message">{{ 'surveyform.firstnameerror' | t }}</div>
              </div>
              <div class="form-field half-width">
                <input type="text" name="last_name" placeholder="{{ 'customer.addresses.last_name' | t }} *" required>
                <div class="error-message">{{ 'surveyform.lastnameerror' | t }}</div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <div class="form-row">
              <div class="form-field half-width">
                <input type="date" name="birth_date" required style="background-image: none;">
                <span class="date-placeholder">{{ 'surveyform.birthdate' | t }} *</span>
                <div class="error-message">{{ 'surveyform.birtherror' | t }}</div>
              </div>
              <div class="form-field half-width">
                <select name="gender" required>
                  <option value="" disabled selected>{{ 'surveyform.gender' | t }} *</option>
                  <option value="Male">{{ 'surveyform.male' | t }}</option>
                  <option value="Female">{{ 'surveyform.female' | t }}</option>
                </select>
                <div class="error-message">{{ 'surveyform.gendererror' | t }}</div>
              </div>
            </div>
          </div>

          <div class="form-group">
            <div class="form-row">
              <div class="form-field half-width">
                <select name="preferred_language">
                  <option value="" disabled selected>{{ 'surveyform.pref_lng' | t }}</option>
                  <option value="English">English</option>
                  <option value="Arabic">Arabic</option>
