{%- comment -%}
------------------------------------------------------------------------------
  Section: Product template
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/carousel.scss' -%}
{%- render 'adastra' with '/src/styles/product.scss' -%}

{%- assign container 					= section.settings.container_width -%}
{%- assign ui_button_color				= section.settings.ui_button_color -%}
{%- assign ui_button_background_color	= section.settings.ui_button_background_color -%}
{%- assign ui_button_border_color		= section.settings.ui_button_border_color -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- capture section_styles -%}
	--container-width: {{ container_width }};
	--ui-button-color: {{ ui_button_color }};
	--ui-button-background-color: {{ ui_button_background_color }};
	--ui-button-border-color: {{ ui_button_border_color }};
	--ui-model-view-button-background-color: {{ ui_button_background_color | color_darken: 5 }};
{%- endcapture -%}

{%- capture size_guide -%}
	{%- if section.settings.show_size_guide -%}
		{%- assign size_guide_page = product.metafields.size_guide.page.value -%}

		{%- if size_guide_page != blank and size_guide_page.content != blank -%}
			{% assign toggle_id = 'productSizeGuideDrawer-' | append: section.id %}
			{% assign size_guide_page_content = size_guide_page.content | replace: '<img', '<img loading="lazy"'%}

			{% render 'product-size-guide-popup',
				product: product,
				title: section.settings.size_guide_drawer_title,
				content: size_guide_page_content,
				toggle_id: toggle_id,
				tab_general_name: section.settings.size_guide_tab_general_name,
				tab_model_name: section.settings.size_guide_tab_model_name
			%}
		{%- endif -%}
	{%- endif -%}
{%- endcapture -%}
{% assign free_product = null %}

{% for collection in product.collections %}
  {% if collection.metafields.custom.free_product.value %}
    {% assign free_product_metafield = collection.metafields.custom.free_product.value %}
    {% comment %} Check if it's a ProductVariant (has .id directly) or Product (needs .selected_or_first_available_variant.id) {% endcomment %}
    {% if free_product_metafield.id %}
      {% assign free_product = free_product_metafield.id %}
    {% elsif free_product_metafield.selected_or_first_available_variant %}
      {% assign free_product = free_product_metafield.selected_or_first_available_variant.id %}
    {% endif %}
    {% if free_product %}
      {% break %}
    {% endif %}
  {% endif %}
{% endfor %}
<section
	class="product-section"
	style="{{ section_styles }}"
	data-section-type="product"
	data-section-id="{{- section.id -}}"
	data-product-handle="{{- product.handle -}}"
	data-free-variant-id="{{ product.metafields.custom.free_product.value.id | remove: 'gid://shopify/ProductVariant/' }}"
	data-free-collection-product-variant-id="{{ free_product | remove: 'gid://shopify/ProductVariant/' }}"
	data-free-variant-price="{{ product.selected_or_first_available_variant.price | money_without_currency }}"
	data-product-tags="{{ product.tags | join: ',' }}"
	data-vendor="{{ product.vendor | escape }}"
	data-js-product-container
>
	{% include 'product-json' %}

	<div class="product product--{{ section.settings.product_layout }}">
		{%- case section.settings.product_layout -%}
			{%- when 'two_columns' -%}
				{%- include 'product-media', media_height: section.settings.media_height -%}
				{%- include 'product-single-col', blocks: section.blocks, product: product, enable_history_state: true, product_template: true -%}
			{%- when 'three_columns' -%}
				{%- render 'product-block-column', col: 'first_column', product: product, section: section, blocks: section.blocks, enable_history_state: true -%}
				{%- include 'product-media', media_height: section.settings.media_height -%}
				{%- render 'product-block-column', col: 'third_column', product: product, section: section, blocks: section.blocks, enable_history_state: true -%}
		{%- endcase -%}
	</div>

	{{- size_guide -}}

	{%- for block in section.blocks -%}
		{%- case block.type -%}
			{% when 'drawers' %}
				{%- render 'product-drawers-content', block: block, product: product, section_id: section.id -%}
			{% when 'notify_me' -%}
				{%- render 'product-notify-me-popup', block: block, section_id: section.id -%}
			{% when 'ask_question' %}
				{%- render 'product-ask-question-popup', block: block, section_id: section.id -%}
		{%- endcase -%}
	{%- endfor -%}
</section>

{% if product.metafields.custom.free_product.value %}
  <script src="{{ 'free-product.js' | asset_url }}" defer></script>
{% endif %}

{% if free_product and product.vendor == 'DICI' %}
  <script src="{{ 'free-collection-product.js' | asset_url }}" defer></script>
{% endif %}

{% if free_product and product.vendor == 'DKNY' %}
  <script src="{{ 'free-dkny-collection-product.js' | asset_url }}" defer></script>
{% endif %}

{% if free_product and product.vendor == 'AIGNER' %}
  <script src="{{ 'free-aigner-collection-product.js' | asset_url }}" defer></script>
{% endif %}

{% if free_product and product.vendor == 'D1 MILANO' %}
	<script src="{{ 'd1-free-gift.js' | asset_url }}" defer></script>
{% endif %}

{% if free_product and product.vendor == 'TORRI' %}
	<script src="{{ 'free-torri-collection-product.js' | asset_url }}" defer></script>
{% endif %}

{%- render 'adastra' with '/src/scripts/section-product.js' -%}
{%- render 'adastra' with '/src/scripts/product-alert-models.js' -%}

{%- for block in section.blocks -%}
	{%- case block.type -%}
			{% when 'store_availability' %}
				{%- render 'adastra' with '/src/scripts/store-availability.js' -%}
	{%- endcase -%}
{%- endfor -%}


{%- liquid
	if product.selected_or_first_available_variant.featured_media
		assign seo_media = product.selected_or_first_available_variant.featured_media
	else
		assign seo_media = product.featured_media
	endif
-%}

<script type="application/ld+json">
	{
	  "@context": "http://schema.org/",
	  "@type": "Product",
	  "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
	{% if seo_media -%}
        "image": [
          {{ seo_media | image_url: width: seo_media.preview_image.width | prepend: "https:" | json }}
        ],
      {%- endif %}
	"description": {{ product.description | strip_html | json }},
	{% if product.selected_or_first_available_variant.sku != blank -%}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif %}
	"brand": {
	  "@type": "Brand",
	  "name": {{ product.vendor | json }}
	},
	"offers": [
	{%- for variant in product.variants -%}
          {
            "@type" : "Offer",
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {%- endif -%}
		{%- if variant.barcode.size == 12 -%}
              "gtin12": {{ variant.barcode }},
            {%- endif -%}
		{%- if variant.barcode.size == 13 -%}
              "gtin13": {{ variant.barcode }},
            {%- endif -%}
		{%- if variant.barcode.size == 14 -%}
              "gtin14": {{ variant.barcode }},
            {%- endif -%}
            "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price" : {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency" : {{ cart.currency.iso_code | json }},
            "url" : {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
	{%- endfor -%}
	]
  }
</script>

{% schema %}
{
	"name": "Product template",
	"settings": [
		{
			"type": "header",
			"content": "Media"
		},
		{
			"type": "checkbox",
			"id": "is_zoom_enabled",
			"label": "Enable zoom",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_arrows_mobile",
			"label": "Show arrows on mobile",
			"default": true
		},
		{
			"type": "select",
			"id": "media_layout",
			"label": "Media layout",
			"info": "Only for Product layout: Two columns",
			"options": [
				{
					"value": "carousel",
					"label": "Carousel"
				},
				{
					"value": "stacked",
					"label": "Stacked"
				},
				{
					"value": "stacked_2_col",
					"label": "Stacked 2 columns"
				},
				{
					"value": "stacked_2_col_with_big_image",
					"label": "Stacked 2 columns with big image"
				}
			],
			"default": "carousel"
		},
		{
			"type": "select",
			"id": "thumbnails_position",
			"label": "Thumbnails position",
			"options": [
				{
					"value": "bottom",
					"label": "Bottom"
				},
				{
					"value": "left",
					"label": "Left"
				}
			],
			"default": "bottom",
			"info": "This setting applies only to the carousel media layout."
		},
		{
			"type": "select",
			"id": "media_height",
			"label": "Media height",
			"options": [
				{
					"value": "full_size",
					"label": "Full size"
				},
				{
					"value": "square",
					"label": "Square"
				},
				{
					"value": "fit_to_screen",
					"label": "Fit to screen"
				}
			],
			"default": "full_size"
		},
		{
			"type": "checkbox",
			"id": "stacked_smooth_scroll",
			"label": "Make smooth scroll for stacked gallery",
			"default": true,
			"info": "Set smooth scroll to anchor on stacked media"
		},
		{
			"type": "checkbox",
			"id": "is_enable_media_scroller",
			"label": "Enable media scroll for stacked layout",
			"default": false,
			"info": "Enables scroll to variant image when changing product options for stacked layout"
		},
		{
			"type": "header",
			"content": "General"
		},
		{
			"type": "select",
			"id": "product_layout",
			"label": "Layout",
			"options": [
				{
					"value": "two_columns",
					"label": "Two columns"
				},
				{
					"value": "three_columns",
					"label": "Three columns"
				}
			],
			"default": "three_columns"
		},
		{
			"type": "checkbox",
			"id": "show_taxes_included",
			"label": "Show message of taxes included",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_pay_installments",
			"label": "Show pay installments",
			"default": true
		},
		{
			"type": "checkbox",
			"id": "show_sticky_add_to_cart",
			"label": "Enable sticky add to cart",
			"default": false
		},
		{
			"type": "header",
			"content": "Size guide"
		},
		{
			"type": "checkbox",
			"id": "show_size_guide",
			"label": "Show size guide",
			"default": true
		},
		{
			"type": "text",
			"id": "size_guide_button_text",
			"label": "Button label",
			"default": "Open a sizeguide"
		},
		{
			"type": "image_picker",
			"id": "size_guide_button_icon",
			"label": "Button icon",
			"info": "24 x 24px .svg recommended"
		},
		{
			"type": "text",
			"id": "size_guide_drawer_title",
			"label": "Popup heading",
			"default": "Size guide"
		},
		{
			"type": "text",
			"id": "size_guide_tab_general_name",
			"label": "General tab label",
			"default": "Dimensions",
			"info": "Size Guide metafield must not be empty for the tab to appear. [Learn more](https://ultra.arvest.digital/product/product-template#size-guide)"
		},
		{
			"type": "text",
			"id": "size_guide_tab_model_name",
			"label": "Model tab label",
			"default": "Model parameters",
			"info": "Size Guide metafield must not be empty for the tab to appear. [Learn more](https://ultra.arvest.digital/product/product-template#size-guide)"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "ui_button_color",
			"label": "UI button color",
			"default": "#000",
			"info": "Used for icon color"
		},
		{
			"type": "color",
			"id": "ui_button_background_color",
			"label": "UI button background color",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "ui_button_border_color",
			"label": "UI button border color",
			"default": "#E9E9E9"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "1952px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "100%",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"blocks": [
		{
			"name": "Badges",
			"type": "badges",
			"limit": 1,
			"settings": [
				{
					"type": "select",
					"id": "position",
					"label": "Block column position",
					"info": "This setting only works for 3 cols layout",
					"default": "third_column",
					"options": [
						{
							"value": "first_column",
							"label": "First column"
						},
						{
							"value": "third_column",
							"label": "Third column"
						}
					]
				},
				{
					"type": "range",
					"id": "offset_top_desktop",
					"min": 0,
					"max": 32,
					"step": 1,
					"unit": "px",
					"label": "Desktop offset top",
					"default": 16
				},
				{
					"type": "range",
					"id": "offset_bottom_desktop",
					"min": 0,
					"max": 32,
					"step": 1,
					"unit": "px",
					"label": "Desktop offset bottom",
					"default": 16
				},
				{
					"type": "range",
					"id": "offset_top_mobile",
					"min": 0,
					"max": 32,
					"step": 1,
					"unit": "px",
					"label": "Mobile offset top",
					"default": 8
				},
				{
					"type": "range",
					"id": "offset_bottom_mobile",
					"min": 0,
					"max": 32,
					"step": 1,
					"unit": "px",
					"label": "Mobile offset bottom",
					"default": 8
				}
